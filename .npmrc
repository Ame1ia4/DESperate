# Dependency version control
save-exact=true
# L6 fix: raised from 5 to 72 days. A 5-day window is too short to catch
# malicious fast-publish attacks where a compromised version is published
# and pulled before the community can identify and report it. 72 days
# provides a realistic detection and response window.
min-release-age=72

# Block execution during install
ignore-scripts=true

# Block git/github dependencies (closes orphan commit attack vector)
allow-git=none

# Audit level - fail on high or critical vulnerabilities
audit-level=high